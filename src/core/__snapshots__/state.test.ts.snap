exports[`exports > CSS in P3 adds a color-gamut block for P3-only tiles 1`] = `
"/* Tonal palette, Display P3 with sRGB fallback */
:root {
  --green-100: #eafbea;
  --green-200: #84d687;
  --green-300: #00a502;
  --green-400: #006800;
  --green-500: #002c00;
}

@supports (color: oklch(0% 0 0)) {
  :root {
    --green-100: oklch(97.2% 0.03 145);
    --green-200: oklch(80.4% 0.136 145);
    --green-300: oklch(62.5% 0.212 142.6);
    --green-400: oklch(44.9% 0.153 142.5);
    --green-500: oklch(25.3% 0.086 142.5);
  }
}

@media (color-gamut: p3) {
  @supports (color: oklch(0% 0 0)) {
    :root {
      --green-300: oklch(61.6% 0.268 145.6);
      --green-400: oklch(44% 0.191 145.6);
      --green-500: oklch(24.5% 0.106 145.6);
    }
  }
}
"
`;

exports[`exports > CSS: hex fallback, then oklch in @supports 1`] = `
"/* Tonal palette, sRGB */
:root {
  --gray-100: #f7f7f6;
  --gray-200: #c5c3c0;
  --gray-300: #908c85;
  --gray-400: #5a5752;
  --gray-500: #242320;
  --blue-100: #f0f8ff;
  --blue-200: #a3c5ff;
  --blue-300: #4789ff;
  --blue-400: #1e51b6;
  --blue-500: #072051;
}

@supports (color: oklch(0% 0 0)) {
  :root {
    --gray-100: oklch(97.5% 0.001 85);
    --gray-200: oklch(81.8% 0.005 85);
    --gray-300: oklch(64.2% 0.012 85);
    --gray-400: oklch(45.8% 0.01 85);
    --gray-500: oklch(25.5% 0.005 85);
    --blue-100: oklch(97.4% 0.013 245);
    --blue-200: oklch(81.9% 0.091 260.9);
    --blue-300: oklch(64.8% 0.188 261);
    --blue-400: oklch(46.6% 0.169 262);
    --blue-500: oklch(25.9% 0.094 262);
  }
}
"
`;


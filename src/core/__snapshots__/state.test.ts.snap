exports[`exports > Tailwind v4 @theme 1`] = `
"/* Tonal palette for Tailwind CSS v4 (sRGB). Paste after @import "tailwindcss"; */
@theme {
  --color-gray-100: oklch(97.5% 0.001 85);
  --color-gray-200: oklch(81.8% 0.005 85);
  --color-gray-300: oklch(64.2% 0.012 85);
  --color-gray-400: oklch(45.8% 0.01 85);
  --color-gray-500: oklch(25.5% 0.005 85);

  --color-blue-100: oklch(97.4% 0.013 245);
  --color-blue-200: oklch(81.9% 0.091 260.9);
  --color-blue-300: oklch(64.8% 0.188 261);
  --color-blue-400: oklch(46.6% 0.169 262);
  --color-blue-500: oklch(25.9% 0.094 262);
}
"
`;
